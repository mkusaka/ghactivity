{
	"name": "ghactivity",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.15.0",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"lint": "oxlint",
		"deploy": "vite build && wrangler deploy",
		"preview": "vite build && vite preview",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
		"typecheck": "pnpm run cf-typegen && tsc --noEmit",
		"typecheck:ci": "tsc --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@cf-wasm/og": "^0.5.0",
		"@hono/inertia": "^0.8.1",
		"@inertiajs/react": "^3.9.1",
		"@octokit/auth-app": "^8.2.0",
		"@octokit/rest": "^22.0.0",
		"@octokit/types": "^18.0.0",
		"feed": "^6.0.0",
		"hono": "^4.13.13",
		"lucide-react": "^1.0.0",
		"motion": "^14.0.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"zod": "^4.0.17"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.64.0",
		"@octokit/openapi-types": "29.0.1",
		"@tailwindcss/vite": "4.3.3",
		"@tanstack/redact": "0.1.4",
		"@types/node": "26.6.5",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.2",
		"oxlint": "1.89.0",
		"tailwindcss": "4.3.3",
		"typescript": "7.0.2",
		"vite": "8.3.4",
		"vite-ssr-components": "0.8.0",
		"vitest": "5.0.5",
		"wrangler": "4.151.3"
	}
}
